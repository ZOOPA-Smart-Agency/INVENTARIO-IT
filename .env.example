# Copy to .env for local development. Never commit .env.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me
DATABASE_URL=postgres://localhost/inventario
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production only: comma-separated origins, e.g. https://inventario.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# Production only: long random code asked for by the first-run wizard.
DJANGO_SETUP_TOKEN=
