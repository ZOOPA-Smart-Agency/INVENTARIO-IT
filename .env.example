# Copy to .env for local development. Never commit .env.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me
DATABASE_URL=postgres://localhost/inventario
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production only: comma-separated origins, e.g. https://inventario.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# Production only: long random code asked for by the first-run wizard.
DJANGO_SETUP_TOKEN=
# Update check: GitHub repository and, because it is private, a read-only fine-grained token
# (repository access: this repo only; permissions: Contents read-only).
APP_UPDATE_REPO=ZOOPA-Smart-Agency/INVENTARIO-IT
APP_UPDATE_TOKEN=
# ...or, where tokens are not allowed, a GitHub App with read-only "Contents" access to the repository:
APP_UPDATE_GITHUB_APP_ID=
APP_UPDATE_GITHUB_APP_PRIVATE_KEY_FILE=
